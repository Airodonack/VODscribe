{
  "name": "vodscribe",
  "private": true,
  "description": "Searchable transcripts for Kick, Twitch, YouTube and other VODs",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "pnpm --filter desktop tauri dev",
    "tauri": "pnpm --filter desktop tauri",
    "check": "pnpm --recursive check",
    "format": "pnpm --recursive format",
    "lint": "pnpm --recursive lint",
    "site": "pnpm --filter site dev"
  },
  "devDependencies": {
    "yaml": "2.8.1"
  }
}
