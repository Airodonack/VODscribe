#!/bin/sh
# Refuses a commit message carrying a co-author trailer or a session link.
# Enable once per clone: git config core.hooksPath .githooks
if grep -qiE '^(claude-session|co-authored-by):|claude\.ai/' "$1"; then
  echo "commit-msg: take the co-author or session line out of the message." >&2
  exit 1
fi
