{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VODscribe",
  "identifier": "app.vodscribe",
  "build": {
    "beforeDevCommand": "pnpm dev:worker && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "VODscribe",
        "width": 1200,
        "height": 800,
        "minWidth": 760,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "media-src": "'self' blob: http://127.0.0.1:* https://*.cloudfront.net https://*.kick.com",
        "connect-src": "'self' ipc: http://ipc.localhost https://*.cloudfront.net https://*.kick.com",
        "frame-src": "https://www.youtube-nocookie.com https://player.twitch.tv",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "devCsp": null,
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/vodscribe-worker"
    ],
    "shortDescription": "Searchable transcripts for Kick, Twitch and YouTube VODs",
    "category": "Video",
    "publisher": "Airodonack",
    "copyright": "© 2026 Airodonack",
    "macOS": {
      "signingIdentity": "-"
    },
    "longDescription": "Paste a Kick, Twitch or YouTube VOD link and get a transcript you can search by phrase. Clicking a match plays the VOD from that moment. Transcription runs locally with NVIDIA's Parakeet model."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDREMkRENkU3QjRENUU5N0EKUldSNjZkVzA1OVl0VGFwTWtqS2xVYkxqYWU1SGdFeGZGWVh6K0FsOHlHa244Tk5DQVZrRjZKQXYK",
      "endpoints": ["https://dl.vodscribe.com/releases/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
