# Desktop entry for the .deb and .rpm (Tauri's default template, with the
# display name fixed, and StartupNotify, so the desktop shows a busy cursor
# until the window appears, which is once the app has loaded). Tauri names Linux packages after productName in
# kebab-case, which would turn "VODscribe" into "vo-dscribe", so
# tauri.linux.conf.json keeps productName lowercase and the name users see
# comes from here.
[Desktop Entry]
Categories={{categories}}
{{#if comment}}
Comment={{comment}}
{{/if}}
Exec={{exec}}
StartupWMClass={{exec}}
StartupNotify=true
Icon={{icon}}
Name=VODscribe
Terminal=false
Type=Application
{{#if mime_type}}
MimeType={{mime_type}}
{{/if}}
